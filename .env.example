# .env.example -> .env nusxasini yarating va qiymatlarni to'ldiring.
# Bu faylga HAQIQIY qiymatlarni yozmang — u git'ga qo'shiladi.
# .env faylini HECH QACHON git'ga qo'shmang (u .gitignore da).

# --- Telegram shaxsiy akkaunt (https://my.telegram.org -> API development tools) ---
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
# Ixtiyoriy: bo'sh qoldirsangiz, birinchi login paytida terminalda so'raladi
PHONE=
# Session fayl nomi (anna -> anna.session). Bu fayl akkauntga to'liq kirish beradi!
USER_SESSION=anna
# Server (Render) uchun: `python export_session.py` chiqargan matn. MAXFIY!
SESSION_STRING=

# --- Online holat ---
# true = dastur ishlab turganda akkauntingiz Telegram'da "online" ko'rinadi
KEEP_ONLINE=true
# Online signal oralig'i (soniya, min. 30)
ONLINE_INTERVAL_SECONDS=60

# --- MongoDB Atlas ---
# Atlas -> Connect -> Drivers dan olingan ulanish satri (login/parol bilan)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=anna_assistant

# --- Anna kotiba (faqat main.py uchun) ---
BOT_TOKEN=123456789:AAAA-BBBB-CCCC
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Ovozli xabarlarni matnga o'girish modeli
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Kotiba suhbatdoshlarga aytadigan ochiq ma'lumotlar (tug'ilgan sana, saytlar...)
OWNER_PROFILE_FILE=owner_profile.txt
OWNER_NAME=Husan Suyunov
ASSISTANT_NAME=Anna
# Suhbatda sizni shunday ataydi: "Sizga Husan akani chaqirib beraymi?"
OWNER_CALL_NAME=Husan aka
# Siz o'zingiz chatga yozsangiz, AI shu chatda necha daqiqa jim turadi
OWNER_TAKEOVER_MINUTES=120

# --- Aqlli rejim (nazorat botida /auto) ---
# Ish vaqti: shu vaqtda kotiba doim javob beradi. Kunlar: Mon..Sun yoki Du,Se,Ch,Pa,Ju,Sh,Ya
# Bir nechta qoida ";" bilan: Mon-Fri 09:00-18:00; Sat 10:00-14:00
BUSY_HOURS=
# Siz oxirgi shuncha daqiqada biror joyga yozgan bo'lsangiz — "faol" hisoblanasiz, kotiba jim turadi
OWNER_ACTIVE_MINUTES=10
# Google Calendar -> Sozlamalar -> kalendar -> "Maxfiy iCal manzili" (MAXFIY! faqat .env da saqlang)
CALENDAR_ICS_URL=

# --- Kunlik hisobot ---
REPORT_ENABLED=true
# Har kuni shu vaqtda (Toshkent) nazorat botiga bugungi xulosa keladi. Istalgan payt: /report
REPORT_TIME=21:00

# --- Shaxsiy buxgalter ---
# Botga "nonga 25 ming ishlatdim" deb yozsangiz yoki aytsangiz — kirim/chiqim yoziladi
FINANCE_ENABLED=true
# Har kuni shu vaqtda moliya hisoboti (har 3 kunda 3 kunlik, haftada haftalik, oy oxirida oylik ham)
FINANCE_REPORT_TIME=22:00
FINANCE_CURRENCY=so'm
# Haftalik hisobot kuni: 1=Dushanba ... 7=Yakshanba
FINANCE_WEEK_DAY=7

# --- Xarajat nazorati (OpenAI) ---
# Kuniga jami AI so'rovlari (javob, ovozni o'girish, rasm, ovozli javob). 0 = cheksiz
AI_DAILY_LIMIT=300
# Bitta odam uchun kuniga. Spam yuboruvchi hisobingizni tugata olmaydi. 0 = cheksiz
AI_CHAT_DAILY_LIMIT=30

# --- Holat nazorati ---
# MongoDB, OpenAI va Telegram'ni tekshirish oralig'i (soniya). Muammo bo'lsa botga xabar keladi
HEALTH_CHECK_SECONDS=300

# --- Ovozli javob ---
# Ovozli xabarga ovoz bilan javob berish
VOICE_REPLY_ENABLED=true
# edge = Microsoft neyron ovozlari: haqiqiy o'zbek talaffuzi, API kalit kerak emas (tavsiya)
# openai = OpenAI ovozlari (o'zbekchada chet el aksenti bor). edge ishlamasa avtomatik openai ishlatiladi
TTS_PROVIDER=edge
# O'zbek ovozi: uz-UZ-MadinaNeural (ayol) yoki uz-UZ-SardorNeural (erkak)
TTS_VOICE_UZ=uz-UZ-MadinaNeural
# Javob ruscha/inglizcha bo'lsa shu ovozlar
TTS_VOICE_RU=ru-RU-SvetlanaNeural
TTS_VOICE_EN=en-US-JennyNeural
# Sur'at (-10% sekinroq, +10% tezroq) va ohang
TTS_RATE=-5%
TTS_PITCH=+0Hz
# OpenAI zaxira ovozi
TTS_MODEL=gpt-4o-mini-tts
# Ovoz: alloy, ash, coral, echo, fable, nova, onyx, sage, shimmer
TTS_VOICE=nova
# Bitta chatga bir daqiqada maksimal javoblar soni
MAX_REPLIES_PER_MINUTE=4
# Javobdan oldin kutish (soniya) - ketma-ket xabarlarni bitta qilib javob berish uchun
REPLY_DELAY_SECONDS=3

# --- Avtomatik bio ---
BIO_ENABLED=true
# true = faqat terminalda ko'rsatadi, Telegram'da HECH NARSA o'zgarmaydi.
# Hammasi to'g'ri ekaniga ishonch hosil qilgach, o'zingiz false qiling.
DRY_RUN=true
BIO_PREFIX=Full Stack Developer
BIO_TEMPLATE={prefix} | 🕒 {time} | {icon} {temp}°C
# Ism yonida joriy vaqt: familiya -> "Suyunov 🕒 14:35" (bio bilan birga yangilanadi)
NAME_CLOCK_ENABLED=true
NAME_TEMPLATE={last_name} 🕒 {time}
# Iqtibos: bio oxiriga qo'shiladi -> ... | 🌤️ 7°C | “Ilm — saodat kaliti”
BIO_QUOTE_ENABLED=true
# Bitta doimiy iqtibos. Bo'sh bo'lsa quotes.txt dan har kuni bittasi almashadi.
BIO_QUOTE=
BIO_QUOTES_FILE=quotes.txt
# 0 = avtomatik (oddiy akkaunt 70, Telegram Premium 140 belgi)
BIO_MAX_LENGTH=0
# Bio va ismdagi soat yangilanish oralig'i (soniya). Eng kami 60.
# 60 = soat har daqiqa aniq. 300 = soat 4 daqiqagacha ortda qoladi, lekin Telegram'ga yuk kamroq.
# FloodWait bo'lsa dastur o'zi kutib, keyin davom etadi.
BIO_UPDATE_INTERVAL_SECONDS=60
# Vaqtinchalik xatodan keyin qayta urinish oralig'i (soniya)
BIO_RETRY_SECONDS=120
# Asl bio'ning mahalliy zaxira fayli
BIO_BACKUP_FILE=bio_backup.json

# --- Vaqt va ob-havo (Open-Meteo, API kalit kerak emas) ---
TIMEZONE=Asia/Tashkent
CITY_NAME=Toshkent, Uzbekistan
LATITUDE=41.2995
LONGITUDE=69.2401
# Ob-havoni olish oralig'i (soniya). Standart 900 = 15 daqiqa
WEATHER_INTERVAL_SECONDS=900
# Ob-havo xizmati ishlamasa, qayta urinish oralig'i
WEATHER_RETRY_SECONDS=120
# Oxirgi ob-havo shuncha vaqtgacha ishlatiladi, keyin "🌡️ --°C" ko'rsatiladi (3 soat)
WEATHER_MAX_AGE_SECONDS=10800

# Media: bundan katta fayllar yuklab olinmaydi va sizga yuborilmaydi (MB)
MAX_MEDIA_MB=50
# AI ga beriladigan suhbat tarixi (oxirgi xabarlar soni)
HISTORY_LIMIT=30
# Havola orqali saqlash (/save): eng katta fayl hajmi (MB)
SAVE_MAX_MB=2000
# Bir vaqtda faqat bitta nusxa ishlaydi (ikkinchisi kutib turadi). O'chirish tavsiya etilmaydi
SINGLE_INSTANCE=true
# Kotiba javobni suhbatdoshning xabariga reply (iqtibos) qilib yozadi
REPLY_QUOTE=true
