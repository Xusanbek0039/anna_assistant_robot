# .env.example -> .env nusxasini yarating va qiymatlarni to'ldiring.
# Bu faylga HAQIQIY qiymatlarni yozmang — u git'ga qo'shiladi.
# .env faylini HECH QACHON git'ga qo'shmang (u .gitignore da).

# --- Telegram shaxsiy akkaunt (https://my.telegram.org -> API development tools) ---
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
# Ixtiyoriy: bo'sh qoldirsangiz, birinchi login paytida terminalda so'raladi
PHONE=
# Session fayl nomi (anna -> anna.session). Bu fayl akkauntga to'liq kirish beradi!
USER_SESSION=anna
# Server (Render) uchun: `python export_session.py` chiqargan matn. MAXFIY!
SESSION_STRING=

# --- Online holat ---
# true = dastur ishlab turganda akkauntingiz Telegram'da "online" ko'rinadi
KEEP_ONLINE=true
# Online signal oralig'i (soniya, min. 30)
ONLINE_INTERVAL_SECONDS=60

# --- MongoDB Atlas ---
# Atlas -> Connect -> Drivers dan olingan ulanish satri (login/parol bilan)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=anna_assistant

# --- Anna kotiba (faqat main.py uchun) ---
BOT_TOKEN=123456789:AAAA-BBBB-CCCC
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Ovozli xabarlarni matnga o'girish modeli
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Ovozni matnga o'girish VoiceLab orqali (o'zbek tiliga mos). Kalit: https://voicelab.uz/app/developer/api-keys
# Bir nechta kalit vergul bilan (soni cheklanmagan): kalit1,kalit2,kalit3,kalit4,kalit5
# Aylanma ishlatiladi: 1 -> 2 -> 3 -> ... -> oxirgisi -> yana 1 (kredit tugasa navbatdagisiga o'tadi).
# Bo'sh bo'lsa — OpenAI ishlatiladi. VoiceLab ishlamay qolsa ham OpenAI zaxira bo'ladi.
VOICELAB_API_KEY=vlk_...,vlk_...,vlk_...
# auto — tilni o'zi aniqlaydi; aniq til: uz, ru, en
VOICELAB_LANGUAGE=auto
# Kotiba suhbatdoshlarga aytadigan ochiq ma'lumotlar (tug'ilgan sana, saytlar...)
OWNER_PROFILE_FILE=owner_profile.txt
OWNER_NAME=Husan Suyunov
ASSISTANT_NAME=Anna
# Suhbatda sizni shunday ataydi: "Sizga Husan akani chaqirib beraymi?"
OWNER_CALL_NAME=Husan aka
# Siz o'zingiz chatga yozsangiz, AI shu chatda necha daqiqa jim turadi
OWNER_TAKEOVER_MINUTES=120

# --- Aqlli rejim (nazorat botida /auto) ---
# Ish vaqti: shu vaqtda kotiba doim javob beradi. Kunlar: Mon..Sun yoki Du,Se,Ch,Pa,Ju,Sh,Ya
# Bir nechta qoida ";" bilan: Mon-Fri 09:00-18:00; Sat 10:00-14:00
BUSY_HOURS=
# Siz oxirgi shuncha daqiqada biror joyga yozgan bo'lsangiz — "faol" hisoblanasiz, kotiba jim turadi
OWNER_ACTIVE_MINUTES=10
# Google Calendar -> Sozlamalar -> kalendar -> "Maxfiy iCal manzili" (MAXFIY! faqat .env da saqlang)
CALENDAR_ICS_URL=

# --- Kunlik hisobot ---
REPORT_ENABLED=true
# Har kuni shu vaqtda (Toshkent) nazorat botiga bugungi xulosa keladi. Istalgan payt: /report
REPORT_TIME=21:00

# --- Shaxsiy buxgalter ---
# Botga "nonga 25 ming ishlatdim" deb yozsangiz yoki aytsangiz — kirim/chiqim yoziladi
FINANCE_ENABLED=true
# Har kuni shu vaqtda moliya hisoboti (har 3 kunda 3 kunlik, haftada haftalik, oy oxirida oylik ham)
FINANCE_REPORT_TIME=22:00
FINANCE_CURRENCY=so'm
# Haftalik hisobot kuni: 1=Dushanba ... 7=Yakshanba
FINANCE_WEEK_DAY=7

# --- Xarajat nazorati (OpenAI) ---
# Kuniga jami AI so'rovlari (javob, ovozni o'girish, rasm, ovozli javob). 0 = cheksiz
AI_DAILY_LIMIT=300
# Bitta odam uchun kuniga. Spam yuboruvchi hisobingizni tugata olmaydi. 0 = cheksiz
AI_CHAT_DAILY_LIMIT=30

# --- Holat nazorati ---
# MongoDB, OpenAI va Telegram'ni tekshirish oralig'i (soniya). Muammo bo'lsa botga xabar keladi
HEALTH_CHECK_SECONDS=300

# --- Ovozli javob ---
# Ovozli xabarga ovoz bilan javob berish
VOICE_REPLY_ENABLED=true
# Ovozli javob faqat VoiceLab orqali (VOICELAB_API_KEY kerak). Ishlamasa — matn yuboriladi va bot sizga xabar beradi
# VoiceLab ovozi (standart: Madina — Honey, o'zbek ayol ovozi). Ro'yxat config.py da
VOICELAB_TTS_VOICE=voice_4ef06e6b-2229-4023-ad66-c2a7a2b736ff
VOICELAB_TTS_SPEED=1.0
# Bitta chatga bir daqiqada maksimal javoblar soni
MAX_REPLIES_PER_MINUTE=4
# Javobdan oldin kutish (soniya) - ketma-ket xabarlarni bitta qilib javob berish uchun
REPLY_DELAY_SECONDS=3

# --- Avtomatik bio ---
BIO_ENABLED=true
# true = faqat terminalda ko'rsatadi, Telegram'da HECH NARSA o'zgarmaydi.
# Hammasi to'g'ri ekaniga ishonch hosil qilgach, o'zingiz false qiling.
DRY_RUN=true
BIO_PREFIX=Full Stack Developer
BIO_TEMPLATE={prefix} | 🕒 {time} | {icon} {temp}°C
# Ism yonida joriy vaqt: familiya -> "Suyunov 🕒 14:35" (bio bilan birga yangilanadi)
NAME_CLOCK_ENABLED=true
NAME_TEMPLATE={last_name} 🕒 {time}
# Iqtibos: bio oxiriga qo'shiladi -> ... | 🌤️ 7°C | “Ilm — saodat kaliti”
BIO_QUOTE_ENABLED=true
# Bitta doimiy iqtibos. Bo'sh bo'lsa quotes.txt dan har kuni bittasi almashadi.
BIO_QUOTE=
BIO_QUOTES_FILE=quotes.txt
# 0 = avtomatik (oddiy akkaunt 70, Telegram Premium 140 belgi)
BIO_MAX_LENGTH=0
# Bio va ismdagi soat yangilanish oralig'i (soniya). Eng kami 60.
# 60 = soat har daqiqa aniq. 300 = soat 4 daqiqagacha ortda qoladi, lekin Telegram'ga yuk kamroq.
# FloodWait bo'lsa dastur o'zi kutib, keyin davom etadi.
BIO_UPDATE_INTERVAL_SECONDS=60
# Vaqtinchalik xatodan keyin qayta urinish oralig'i (soniya)
BIO_RETRY_SECONDS=120
# Asl bio'ning mahalliy zaxira fayli
BIO_BACKUP_FILE=bio_backup.json

# --- Vaqt va ob-havo (Open-Meteo, API kalit kerak emas) ---
TIMEZONE=Asia/Tashkent
CITY_NAME=Toshkent, Uzbekistan
LATITUDE=41.2995
LONGITUDE=69.2401
# Ob-havoni olish oralig'i (soniya). Standart 900 = 15 daqiqa
WEATHER_INTERVAL_SECONDS=900
# Ob-havo xizmati ishlamasa, qayta urinish oralig'i
WEATHER_RETRY_SECONDS=120
# Oxirgi ob-havo shuncha vaqtgacha ishlatiladi, keyin "🌡️ --°C" ko'rsatiladi (3 soat)
WEATHER_MAX_AGE_SECONDS=10800

# Media: bundan katta fayllar yuklab olinmaydi va sizga yuborilmaydi (MB)
MAX_MEDIA_MB=50
# AI ga beriladigan suhbat tarixi (oxirgi xabarlar soni)
HISTORY_LIMIT=30
# Havola orqali saqlash (/save): eng katta fayl hajmi (MB)
SAVE_MAX_MB=2000
# --- Chat arxivi (botda: 🗂 Chat arxivi tugmasi yoki /arxiv) ---
# Barcha shaxsiy chatlar (istisnodagilar ham) MongoDB'ga yozib boriladi. Suhbatdosh xabar yoki butun
# chatni o'chirsa — bot ogohlantiradi va yozishmani HTML fayl qilib yuklab olish mumkin.
ARCHIVE_ENABLED=true
# Guruhlar ham arxivlansinmi (xabar juda ko'p bo'lishi mumkin)
ARCHIVE_GROUPS=false
# Xabar o'chirilganda botga ogohlantirish
ARCHIVE_ALERTS=true
# Shu hajmgacha (KB) rasm va ovozli xabarlar ham arxivga saqlanadi (0 = faqat matn). MongoDB joyini tejang
ARCHIVE_MEDIA_MAX_KB=512
# HTML faylga chatning oxirgi nechta xabari kiradi
ARCHIVE_EXPORT_LIMIT=5000
# Chat tarixini olganda rasm, ovozli va video-xabarlar ham HTML ichida ko'rinadi: arxivda bo'lmasa Telegram'dan
# shu hajmgacha (KB) yuklab olinadi va arxivga saqlanadi (keyin o'chirilsa ham qoladi). 0 = yuklamaslik
EXPORT_MEDIA_MAX_KB=2048
# Ishga tushganda mavjud chatlardagi yozishmalar ham arxivga nusxalanadi (faqat matn).
# Birinchi marta har chatdan shuncha oxirgi xabar, keyin — faqat yangilari. 0 = nusxalamaslik
ARCHIVE_SYNC_LIMIT=1000

# --- Google Drive: chat arxivi Drive papkasiga HTML bo'lib saqlanadi (har chatga bitta fayl, yangilanib boradi) ---
# 1) console.cloud.google.com -> APIs & Services -> Library -> «Google Drive API» -> Enable
# 2) OAuth consent screen -> Publishing status: «In production» (Testing'da token 7 kunda o'chadi)
# 3) Credentials -> Create credentials -> OAuth client ID -> Application type: Desktop app
# 4) `python drive_auth.py` -> brauzerda ruxsat bering -> refresh token .env ga yoziladi
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Drive'dagi papka havolasining oxiri: drive.google.com/drive/folders/<SHU_QISMI>
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# O'zgargan chatlar shuncha daqiqada bir Drive'ga yuklanadi
DRIVE_SYNC_MINUTES=10
# Chatlardagi rasm, video, ovozli va video-xabarlar ham Drive'ga (har chatning o'z papkasiga) asl holida yuklanadi
DRIVE_MEDIA_ENABLED=true
# Bundan katta media (MB) yuklanmaydi
DRIVE_MEDIA_MAX_MB=300
# Mavjud chatlardagi eski rasm/videolar ham yuklansin (yangi kelganlar doim birinchi navbatda)
DRIVE_MEDIA_HISTORY=true
# Hujjat/fayllar (pdf, zip, docx ...) ham yuklansinmi
DRIVE_MEDIA_FILES=false

# --- Kuzatuv (botda: 🗂 Chat arxivi -> ⚙️ Kuzatuv sozlamalari) ---
# Suhbatdosh xabarini tahrirlasa — avvalgi va yangi matni bilan ogohlantirish
EDIT_ALERTS=true
# Yozishgan odamlaringiz ism, username, bio yoki rasmini o'zgartirsa / akkauntini o'chirsa — ogohlantirish
PROFILE_WATCH=true
PROFILE_CHECK_HOURS=6
# Profil rasmlari tarixi Drive'dagi chat papkasiga (profil_rasmlari/)
PROFILE_PHOTOS=true

# --- 🔔 Eslatmalar: «95 446 68 86 raqami tg ga qo'shilsa xabar ber», «@ali online bo'lsa xabar ber» (/eslatma) ---
WATCH_ENABLED=true
# Raqam Telegram'da paydo bo'lganini tekshirish oralig'i (daqiqa, min. 5)
WATCH_PHONE_MINUTES=15
# Online holat zaxira tekshiruvi (soniya, min. 30); asosan Telegram o'zi real vaqtda yuboradi
WATCH_ONLINE_SECONDS=60
# «Har safar online bo'lganda» rejimida xabarlar orasidagi eng kam vaqt (daqiqa)
WATCH_ONLINE_COOLDOWN_MINUTES=10
# 9 xonali raqamga qo'shiladigan mamlakat kodi (90 123 45 67 -> +998 90 123 45 67)
WATCH_COUNTRY_CODE=998
INSTAGRAM_ENABLED=true
IG_POLL_SECONDS=30
IG_AUTOREPLY=false
IG_FORWARD=false
# Ulangach mavjud chatlardagi ESKI yozishmalar ham arxivga olinadi: har chatdan shuncha xabar (0 = olmaslik)
IG_SYNC_LIMIT=1000
# Instagram arxivi Google Drive'ga: <asosiy papka>/Instagram/<chat nomi>.html (oralig'i: DRIVE_SYNC_MINUTES)
IG_DRIVE=true
# Faqat sotib olingan PROKSI ma'lumoti (Instagram login/paroli EMAS!). Proksi bo'lmasa — bo'sh qoldiring
IG_PROXY=
VIEWERS_ENABLED=true
VIEWERS_CHECK_MINUTES=3

# --- Va'dalar: AI yozishmalardan siz bergan va'dalarni topadi va muddatida eslatadi (/vadalar) ---
PROMISE_SCAN=true
PROMISE_SCAN_TIME=21:30
PROMISE_REMIND_TIME=09:00
PROMISE_SCAN_CHATS=15

# --- Haftalik chat hisoboti (1=Dushanba ... 7=Yakshanba) ---
WEEKLY_REPORT=true
WEEKLY_REPORT_DAY=7
WEEKLY_REPORT_TIME=20:00

# --- Bazani har kuni Google Drive'ga zaxiralash (Drive'da: Anna zaxira/<sana>/) ---
BACKUP_ENABLED=true
BACKUP_TIME=04:00
BACKUP_KEEP_DAYS=14
BACKUP_MEDIA=true
# Bir vaqtda faqat bitta nusxa ishlaydi (ikkinchisi kutib turadi). O'chirish tavsiya etilmaydi
SINGLE_INSTANCE=true
# Kotiba javobni suhbatdoshning xabariga reply (iqtibos) qilib yozadi
REPLY_QUOTE=true
